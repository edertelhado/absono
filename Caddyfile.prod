# App principal: frontend (nginx) que por sua vez proxia /api e /ws ao backend.
# O LiveKit (sinalizacao WebSocket) fica montado em /livekit com prefixo removido.
#
# Sem bloco de email: o LE aceita conta sem contato e o Caddy renova sozinho.
# Para receber avisos de expiracao adicione manualmente um bloco global:
#   { email voce@seudominio.com }

{$PUBLIC_APP_DOMAIN} {
	encode gzip zstd

	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Endpoint S3 do Garage. O Host original PRECISA ser preservado (assinatura SigV4),
# e o Caddy repassa o Host recebido por padrao.
{$PUBLIC_S3_DOMAIN} {
	# CORS global - aplicado a todas as respostas
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, PUT, POST, DELETE, HEAD, OPTIONS"
		Access-Control-Allow-Headers "*"
		Access-Control-Expose-Headers "ETag, Content-Length, Content-Range"
		Access-Control-Max-Age "3600"
	}

	# Resposta para preflight (OPTIONS)
	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}

	# Proxy para o Garage
	reverse_proxy garage:3902 {
		# Remove headers CORS do Garage para evitar duplicação
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Expose-Headers
	}
}
