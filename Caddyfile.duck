# Desafio DNS-01 via DuckDNS — nao precisa das portas 80/443 publicas.
# Sem bloco de email: o LE aceita conta sem contato e o Caddy renova sozinho.
# Para receber avisos de expiracao adicione manualmente um bloco global:
#   { email voce@seudominio.com }
{$PUBLIC_APP_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
	encode gzip zstd

	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy frontend:80
	}
}

{$PUBLIC_S3_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS"
	header Access-Control-Allow-Headers "*"
	header Access-Control-Expose-Headers "ETag, Content-Length, Content-Range"

	# Garante que OPTIONS retorna 200 com os headers corretos
	@options method OPTIONS
	handle @options {
	 respond 204
	}

	reverse_proxy garage:3902
}
