# Desafio DNS-01 via DuckDNS — nao precisa das portas 80/443 publicas.
# Sem bloco de email: o LE aceita conta sem contato e o Caddy renova sozinho.
# Para receber avisos de expiracao adicione manualmente um bloco global:
#   { email voce@seudominio.com }
{$PUBLIC_APP_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
	encode gzip zstd

	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy frontend:80
	}
}

{$PUBLIC_S3_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# CORS global - aplicado a todas as respostas
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, PUT, POST, DELETE, HEAD, OPTIONS"
		Access-Control-Allow-Headers "*"
		Access-Control-Expose-Headers "ETag, Content-Length, Content-Range"
		Access-Control-Max-Age "3600"
	}

	# Resposta para preflight (OPTIONS)
	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}

	# Proxy para o Garage
	reverse_proxy garage:3902 {
		# Remove headers CORS do Garage para evitar duplicação
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Expose-Headers
	}
}
