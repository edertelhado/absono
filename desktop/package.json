{
  "name": "absono-desktop",
  "version": "1.0.0",
  "description": "Ábsono - Aplicação de comunicação corporativa",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.absono.app",
    "productName": "Ábsono",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "picker-preload.cjs"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
