# === PostgreSQL ===
POSTGRES_DB=absono
POSTGRES_USER=absono
POSTGRES_PASSWORD=absono_secret
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/absono

# === Redis ===
REDIS_PORT=6379

# === LiveKit ===
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=absono-livekit-dev-secret-32-chars!!
LIVEKIT_URL=ws://localhost:7880

# === Garage (S3-compatible) ===
GARAGE_API_PORT=3900
GARAGE_WEB_PORT=3901
GARAGE_S3_PORT=3902
GARAGE_S3_WEB_PORT=3903
GARAGE_ENDPOINT=http://localhost:3902
GARAGE_ACCESS_KEY=garage_access_key
GARAGE_SECRET_KEY=garage_secret_key
GARAGE_BUCKET=absono
GARAGE_REGION=garage

# === Spring Boot ===
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=your-jwt-secret-key-change-in-production

# ============================================================
# PUBLICAÇÃO NA VPS (usados pelo compose.prod.yml + Caddy)
# Sem domínio próprio: use sslip.io — o IP vira nome DNS grátis.
# Ex.: IP da VPS = 201.71.20.54  →  201-71-20-54.sslip.io
# Rode: docker compose -f compose.prod.yml up -d --build
# ============================================================

# Domínio do app (sslip.io derivado do IP da VPS)
PUBLIC_APP_DOMAIN=201-71-20-54.sslip.io

# Domínio do S3 (garage) — subdomínio do anterior, para assinatura SigV4
PUBLIC_S3_DOMAIN=s3.201-71-20-54.sslip.io

# E-mail para avisos do Let's Encrypt (opcional)

# Derivados automaticamente (não precisa editar):
#   LIVEKIT_URL      -> wss://<PUBLIC_APP_DOMAIN>:<HTTPS_PORT>/livekit
#   GARAGE_ENDPOINT  -> https://<PUBLIC_S3_DOMAIN>:<HTTPS_PORT>
#   GARAGE_INTERNAL_ENDPOINT -> http://garage:<GARAGE_S3_PORT> (rede docker;
#       usado pelo backend p/ head/get/put/delete — evita hairpin NAT.
#       Presigned URLs continuam usando o endpoint público.)

# --- Alternativa DuckDNS (portas 80/443 bloqueadas) ---
# Suba com: docker compose -f compose.prod.yml -f compose.duck.yaml up -d --build
#
# 1) No painel do DuckDNS registre DOIS nomes: absono e absono-s3
# 2) Preencha:
DUCKDNS_TOKEN=seu-token-do-duckdns
DUCKDNS_DOMAINS=absono,absono-s3
HTTP_PORT=8081
HTTPS_PORT=4432
CADDYFILE=./Caddyfile.duck
# 3) Ajuste também PUBLIC_APP_DOMAIN=absono.duckdns.org
#    e PUBLIC_S3_DOMAIN=absono-s3.duckdns.org

# Use um segredo forte em produção (ex.: openssl rand -base64 48)
